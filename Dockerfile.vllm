# Inference server image — use one container per replica (same image, different ports / GPUs).
# Pin tag in production; `latest` tracks upstream.
# Pin for reproducibility; bump when you validate a new vLLM release.
FROM vllm/vllm-openai:v0.6.3.post1

# Default model; override via docker command / runner.
ENV HF_HOME=/root/.cache/huggingface
